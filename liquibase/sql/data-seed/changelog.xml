<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

  <!-- V9a: Add a new column "Source" to FeedbackAudit -->
  <changeSet id="V9a-add-Source-column" author="redgate">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="FeedbackAudit" columnName="Source" schemaName="RedGateSchema"/>
      </not>
    </preConditions>
    <addColumn tableName="FeedbackAudit" schemaName="RedGateSchema">
      <column name="Source" type="NVARCHAR(50)"/>
    </addColumn>
  </changeSet>

  <!-- V9b: Insert sample data -->
  <changeSet id="V9b-insert-sample-feedbackaudit" author="redgate" runOnChange="true">
    <insert tableName="FeedbackAudit" schemaName="RedGateSchema">
      <column name="CustomerID" valueNumeric="11000"/>
      <column name="Note" value="Seed row one"/>
      <column name="Source" value="web"/>
    </insert>
    <insert tableName="FeedbackAudit" schemaName="RedGateSchema">
      <column name="CustomerID" valueNumeric="11001"/>
      <column name="Note" value="Seed row two"/>
      <column name="Source" value="email"/>
    </insert>
  </changeSet>
</databaseChangeLog>