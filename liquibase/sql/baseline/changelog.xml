<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- V1_baseline.sql for SQL Server -->
    <changeSet id="V1-baseline-sqlserver" author="redgate">
        <createTable tableName="CustomerFeedback" schemaName="Sales">
            <column name="FeedbackID" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="CustomerID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="Rating" type="INT"/>
            <column name="FeedbackText" type="NVARCHAR(MAX)"/>
            <column name="SubmittedAt" type="DATETIME2" defaultValueComputed="SYSUTCDATETIME()"/>
            <column name="Status" type="VARCHAR(20)" defaultValue="active">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint 
            baseTableName="CustomerFeedback"
            baseTableSchemaName="Sales"
            baseColumnNames="CustomerID"
            referencedTableName="Customer"
            referencedTableSchemaName="Sales"
            referencedColumnNames="CustomerID"
            constraintName="FK_CustomerFeedback_Customer"/>

        <createView viewName="CustomerFeedbackSummary" schemaName="Sales">
            SELECT
                c.CustomerID,
                c.AccountNumber,
                f.FeedbackID,
                f.Rating,
                f.FeedbackText,
                f.SubmittedAt,
                f.Status
            FROM Sales.Customer c
            LEFT JOIN Sales.CustomerFeedback f ON c.CustomerID = f.CustomerID
        </createView>
    </changeSet>
    
</databaseChangeLog>
