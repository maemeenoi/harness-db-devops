<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

  <!-- V10a: Update the view to remove Note so dropping the column won't break it -->
  <changeSet id="V10a-update-FeedbackAuditSummary-no-Note" author="redgate">
    <createView viewName="FeedbackAuditSummary" schemaName="RedGateSchema" replaceIfExists="true">
      SELECT
        AuditID,
        CustomerID,
        CreatedAt
      FROM RedGateSchema.FeedbackAudit
    </createView>
  </changeSet>

  <!-- V10b: Drop the Note column from RedGateSchema.FeedbackAudit -->
  <changeSet id="V10b-drop-Note-column" author="redgate">
    <preConditions onFail="MARK_RAN">
      <columnExists schemaName="RedGateSchema" tableName="FeedbackAudit" columnName="Note"/>
    </preConditions>
    <dropColumn schemaName="RedGateSchema" tableName="FeedbackAudit" columnName="Note"/>
  </changeSet>

</databaseChangeLog>